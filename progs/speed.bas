10 SLOW
20 CLS
[zx64] 30 PRINT "ZX64 SPEED TEST"
[zx128] 30 PRINT "ZX128 SPEED TEST"
[zx128vic] 30 PRINT "ZX128VIC SPEED TEST"
40 PRINT
42 IF PEEK 0<>211 THEN GOTO 50
44 PRINT "A REAL ZX81 (ITS ROM UNPATCHED)"
46 GOTO 80
[zx64] 50 PRINT "C64 VIDEO:   ";("PAL" AND PEEK 62118=1);("NTSC" AND PEEK 62118<>1)
[zx64] 60 PRINT "/INT SEEN:   ";PEEK {irqseen}
[zx128,zx128vic] 50 PRINT "VIC VIDEO:   ";("PAL" AND PEEK {vidpal}<>0);("NTSC" AND PEEK {vidpal}=0)
70 PRINT "STRAY IRQS:  ";PEEK {stray}+256*PEEK {stray+1}
80 PRINT
90 PRINT "50 LOOPS TAKE..."
100 LET F=PEEK 16436+256*PEEK 16437
110 FOR I=1 TO 50
120 NEXT I
130 LET F=F-PEEK 16436-256*PEEK 16437
140 PRINT F;" FRAMES"
150 PRINT
160 PRINT "A UK ZX81: 56-58 (SLOW, 50 HZ)"
