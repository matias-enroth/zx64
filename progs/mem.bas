10 REM {bin:memtest}
20 SLOW
30 CLS
40 LET R=PEEK 16388+256*PEEK 16389
50 PRINT "ZX64 MEMORY TEST"
60 PRINT
70 PRINT "RAMTOP   ";R
80 PRINT "RAM      ";(R-16384)/1024;"K"
90 PRINT
100 PRINT "EVERY FREE BYTE, TWICE..."
110 LET E=USR 16514
120 LET F=PEEK {mt_from}+256*PEEK {mt_from+1}
130 LET T=PEEK {mt_to}+256*PEEK {mt_to+1}
140 PRINT "FREE     ";T-F;" BYTES"
150 PRINT "         ";F;" TO ";T-1
160 PRINT
170 IF E=0 THEN PRINT "MEMORY OK"
180 IF E THEN PRINT E;" BAD, FIRST AT ";PEEK {mt_first}+256*PEEK {mt_first+1}
